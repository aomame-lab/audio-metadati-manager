# ------------------------------------------------------------
# Audio Metadati Manager — Docker Compose environment
# ------------------------------------------------------------
# Copy this file to ".env" and adjust the values for your machine:
#
#   cp .env.example .env
#
# ".env" is git-ignored and stays on your computer only.
# This ".env.example" file is committed and contains no secrets.

# ------------------------------------------------------------
# PRIMARY MUSIC FOLDER
# ------------------------------------------------------------
# MUSIC_PATH — absolute path on the HOST where your music library lives.
# This folder is mounted inside the container as /music (the library root).
#
# DEFAULT: ./music  (a folder named "music" in the project directory)
# If you don't create .env or don't set MUSIC_PATH, a "music" folder will be
# created inside the project directory and used as the library root.
#
# RECOMMENDED: Set an absolute path on your host for a persistent location
# outside the project. Examples:
#   macOS / Linux : MUSIC_PATH=/home/yourname/audio-metadati-manager/music
#   Windows       : MUSIC_PATH=C:/Users/yourname/audio-metadati-manager/music
#   Linux server  : MUSIC_PATH=/srv/audio-metadati-manager/music
#
# The folder MUST already exist. If it doesn't, Docker creates an empty one.
# On macOS/Windows the folder must be shared with Docker Desktop.
# The container needs write access to it: it stores the metadata and the
# embedded cover art in your audio files.
MUSIC_PATH=./music

# ------------------------------------------------------------
# OPTIONAL — Additional music folders (other disks / locations)
# ------------------------------------------------------------
# MUSIC_PATH_2 and MUSIC_PATH_3 let you register music that lives on a
# different disk or on another machine. Inside the container each one gets
# its own stable path, so the application never confuses them:
#
#   MUSIC_PATH   -> /music
#   MUSIC_PATH_2 -> /music-roots/music2
#   MUSIC_PATH_3 -> /music-roots/music3
#
# They are entirely optional: leave them commented out (or empty) and the
# application behaves exactly as before, with a single root.
#
# Example with two music folders on two different disks:
#
#   MUSIC_PATH=/mnt/primary-disk/music
#   MUSIC_PATH_2=/mnt/secondary-disk/albums
#
# Then run:  docker compose up -d --build
#
# Then open the "Cartelle musicali" button in the toolbar to choose which
# sub-folders of each root belong to your library.
#
# Notes:
#   - the host folder MUST exist: these mounts use create_host_path: false,
#     so a wrong path makes Docker fail loudly instead of silently creating
#     an empty folder;
#   - adding a new host path to .env requires recreating the container
#     (docker compose up -d);
#   - the extra mounts are read-write (like /music) because the application
#     writes the tags and the embedded cover INTO the audio files. If you only
#     want to browse those roots without editing them, add "read_only: true" to
#     the matching entry in docker-compose.yml.
# MUSIC_PATH_2=/absolute/path/to/your/second/music/folder
# MUSIC_PATH_3=/absolute/path/to/your/third/music/folder

# ------------------------------------------------------------
# OPTIONAL — Port (defaults to 8000)
# ------------------------------------------------------------
# PORT=8000