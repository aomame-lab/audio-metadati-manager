# ------------------------------------------------------------
# Audio Manager — Git ignore rules
# ------------------------------------------------------------

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches and artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Local configuration (contains machine-specific paths)
web/config.local.php
web/config.php.bak
config.local.php

# Personal tooling configuration
opencode.json
opencode.jsonc

# Local music / sample audio files and cover images
Soundgarden - Superunknown/
sample/music/
*.mp3
*.flac
*.m4a
*.jpg
*.jpeg

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Editor / IDE
.idea/
.vscode/*
!.vscode/settings.json
*.sublime-workspace
*.sublime-project

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
.DS_Store

# Backups
*.bak
*.orig
*.old